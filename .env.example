# Gmail OAuth
GOOGLE_CLIENT_ID=your_google_oauth_client_id
GOOGLE_CLIENT_SECRET=your_google_oauth_client_secret
GOOGLE_REFRESH_TOKEN=your_gmail_refresh_token

# Gmail Push Notifications (Google Cloud Pub/Sub)
# Format: projects/YOUR_PROJECT_ID/topics/YOUR_TOPIC_NAME
GMAIL_PUBSUB_TOPIC=projects/your-project-id/topics/gmail-push

# Gemini AI
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-2.0-flash

# Telegram Bot
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
# Optional: set explicitly, or send /start to the bot and it will learn your chat ID
TELEGRAM_CHAT_ID=
# Production only — leave empty in development (polling is used instead)
TELEGRAM_WEBHOOK_URL=https://your-app.up.railway.app/webhooks/telegram

# Server
PORT=3001
NODE_ENV=development

# Database (Railway: use a persistent volume path like /data/smartmail.db)
DB_PATH=./smartmail.db

# Multi-user prep (optional — for future SaaS, identifies default user)
DEFAULT_USER_EMAIL=your@gmail.com

# Cron Schedules (optional overrides)
DAILY_SUMMARY_CRON=0 21 * * *
WEEKLY_SUMMARY_CRON=0 20 * * 0
DEADLINE_REMINDER_CRON=0 8 * * *
EXPIRED_CLEANUP_CRON=0 0 * * *
GMAIL_WATCH_CRON=0 */6 * * *

# Notification thresholds
INSTANT_NOTIFY_THRESHOLD=0.7
DAILY_SUMMARY_TIME=21:00
WEEKLY_SUMMARY_DAY=0
WEEKLY_SUMMARY_TIME=20:00
DEADLINE_REMINDER_TIME=08:00
